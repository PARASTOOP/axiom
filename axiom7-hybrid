function sqTh(t){return TH[t]||TH.trivia;}
function lv(id){return LEVELS[id]||LEVELS[1];}
function cur(){return gs.players[gs.currentTurn];}
function curPos(){return gs.positions[gs.currentTurn];}
function curSq(){return SQ[gs.selectedSq??curPos()];}
function curRole(){return ROLES[cur().roleIdx%ROLES.length];}
function curToken(){return TOKENS[cur().tokenIdx%TOKENS.length];}
function isOver(x,y,w,h){return mouseX>=x&&mouseX<=x+w&&mouseY>=y&&mouseY<=y+h;}
function a(alpha){return alpha;}  // shorthand, alpha inline

function pickQ(type,lvl){
  let bank=(QB[type]||QB.trivia)[min(lvl,3)];
  let v=bank.filter(q=>q.q.length>0);
  return v[floor(random(v.length))];
}

function addLog(msg){
  gs.missionLog.unshift(msg);
  if(gs.missionLog.length>6)gs.missionLog.pop();
}

// ── GAME LOGIC ────────────────────────────────────────────────────────

function doRoll(){
  let d=floor(random(1,7));
  gs.diceRoll=d;
  let newPos=min(curPos()+d,19);
  gs.positions[gs.currentTurn]=newPos;
  gs.selectedSq=newPos;
  gs.levelPreviews=null; gs.previewSqId=-1;
  let sq=SQ[newPos], tk=curToken();
  addLog('🎲 '+cur().name+' rolled '+d+' → '+sq.label);
  if(newPos===19){gs.winner=gs.currentTurn;gs.screen='winner';}
  else if(sq.t==='start'){nextTurn();}
  else{
    gs.screen='challenge'; gs.selectedLvl=null;
    gs.challengePhase='picking'; gs.currentQ=null; gs.timerActive=false;
  }
  saveGame();
}

function awardPoints(playerIdx,pts){
  if(playerIdx<0||playerIdx>=gs.numPlayers)return;
  gs.scores[playerIdx]=max(0,gs.scores[playerIdx]+pts);
  gs.scoreAnim={player:playerIdx,pts,frame:0};
  if(pts>0)addLog('⭐ '+gs.players[playerIdx].name+' +'+pts+' pts');
  gs.screen='score'; saveGame();
}

function nextTurn(){
  gs.currentTurn=(gs.currentTurn+1)%gs.numPlayers;
  gs.diceRoll=null; gs.selectedSq=null; gs.selectedLvl=null;
  gs.challengePhase='picking'; gs.currentQ=null;
  gs.timerActive=false; gs.timer=0; gs.levelPreviews=null;
  gs.screen='roll'; updateInputVis(); saveGame();
}

function resetGame(){
  gs.positions=Array(gs.numPlayers).fill(0);
  gs.scores=Array(gs.numPlayers).fill(0);
  gs.currentTurn=0; gs.diceRoll=null; gs.selectedSq=null;
  gs.selectedLvl=null; gs.challengePhase='picking'; gs.currentQ=null;
  gs.timerActive=false; gs.timer=0; gs.winner=null;
  gs.rolling=false; gs.levelPreviews=null; gs.missionLog=[];
  gs.screen='roll'; updateInputVis(); saveGame();
}

// ── PERSISTENCE ───────────────────────────────────────────────────────

function saveGame(){
  try{localStorage.setItem('axiom7v2',JSON.stringify({
    numPlayers:gs.numPlayers,players:gs.players,positions:gs.positions,
    scores:gs.scores,currentTurn:gs.currentTurn,winner:gs.winner,
    missionLog:gs.missionLog,
  }));}catch(e){}
}
function loadSavedGame(){
  try{
    let d=JSON.parse(localStorage.getItem('axiom7v2'));
    if(!d||!d.players)return false;
    Object.assign(gs,{numPlayers:d.numPlayers,players:d.players,
      positions:d.positions,scores:d.scores,currentTurn:d.currentTurn,
      winner:d.winner,missionLog:d.missionLog||[]});
