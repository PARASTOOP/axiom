  lbl(l.sym+'  '+l.label+'  Challenge',28,116,[...l.col,225],11.5,LEFT,FD);
  fill(255,255,255,88);textSize(8.5);textFont(FB);text('('+l.pts+' pts)',W-35,116,RIGHT);
  clearGlow();
  fill(...th.tc,215);textSize(13.5);textAlign(LEFT,TOP);textFont(FB);textWrap(WORD);
  text(q.q,28,150,W-66,148);textWrap(CHAR);

  // Hint
  if(q.hint&&q.hint.length>0){
    btn('💡 HINT  (−1 pt)',22,328,156,28,[18,13,5],[200,175,80,210],9.5,[186,133,42,85]);
  }

  // Timer - MORE VISUAL
  let tf=gs.timerMax>0?gs.timer/gs.timerMax:1;
  let ts=ceil(gs.timer/60);
  let tc=tf>0.4?[68,188,108]:tf>0.2?[210,165,45]:[225,75,55];
  let tp=100-floor(tf*100);
  fill(10,7,2,225);stroke(...tc,65);strokeWeight(1.1);rect(18,368,W-36,28,5);noStroke();
  if(tf>0){fill(...tc,220);noStroke();rect(18,368,max(2,(W-36)*tf),28,5);}
  fill(0,0,0,188);noStroke();rect(18,368,W-36,28,5);
  glow(tc,tf<0.2?8:4);
  lbl(ts+'s  ·  '+tp+'% elapsed',W/2,384,[...tc,245],12,CENTER,FD);
  clearGlow();
  if(tf<0.2&&gs.timer%60<30){stroke(...tc,145);strokeWeight(1.4);noFill();rect(18,368,W-36,28,5);noStroke();}

  btn('✓  MARK ANSWERED',W/2-140,412,280,48,l.col.map(v=>v*0.42),[255,255,255,248],13.5,l.col.map(v=>v*0.75));
  btn('✗  Give Up',W/2-88,468,176,32,[24,12,8],[194,82,48,180],10.5,[194,82,48,75]);
}

// ── SCREEN: SCORE ─────────────────────────────────────────────────────

function drawScore(){
  let sq=curSq(),l=lv(gs.selectedLvl??1);
  let q=gs.currentQ||{q:'',a:'',hint:'',card:sq.code};
  hdr('⭐  Award Points  ·  '+sq.label+'  ['+sq.code+']',[...l.col]);

  // Answer card - LARGER AND MORE VISUAL
  fill(6,9,6,230);stroke(68,178,98,110);strokeWeight(1.4);rect(18,66,W-36,130,6);noStroke();
  fill(48,158,78,22);noStroke();rect(18,66,W-36,36,6,6,0,0);
  fill(68,178,98,255);noStroke();rect(18,66,5,130,6,0,0,6);
  glow([88,198,108],10);
  lbl('✓  CORRECT ANSWER',28,84,[108,218,128,235],11.5,LEFT,FD);clearGlow();
  fill(210,230,210,210);textSize(11.5);textAlign(LEFT,TOP);textFont(FB);textWrap(WORD);
  text(q.a||'See physical card '+sq.code,28,110,W-62,78);textWrap(CHAR);

  // Award
  lbl('AWARD +'+l.pts+' pts to:',20,212,[186,133,42,175],11.5,LEFT,FD);
  let slots=gs.numPlayers+1,bw=(W-44)/slots-2;
  gs.players.slice(0,gs.numPlayers).forEach((p,i)=>{
    let act=i===gs.currentTurn,tk2=TOKENS[p.tokenIdx%TOKENS.length];
    let bx=20+i*(bw+2);
    fill(...tk2.col,act?38:18);stroke(...tk2.col,act?115:48);strokeWeight(act?1.3:0.6);
    rect(bx,226,bw,66,5);noStroke();
    fill(...tk2.col,220);noStroke();rect(bx+4,228,6,62,3);
    lbl(p.name,bx+15,243,act?[220,200,130,228]:[186,133,42,150],10,LEFT,FD);
    lbl(gs.scores[i]+' → '+(gs.scores[i]+l.pts),bx+15,266,[...tk2.col,205],11);
    btn('+'+l.pts,bx+bw-38,243,32,24,l.col.map(v=>v*0.6),[255,255,255,238],11,l.col.map(v=>v*0.8));
  });
  btn('Nobody\n(0 pts)',20+gs.numPlayers*(bw+2),226,bw,66,[22,12,8],[194,82,48,180],9,[194,82,48,70]);

  // Score anim
  if(gs.scoreAnim){
    let frac=gs.scoreAnim.frame/55,ay=196-frac*72;
    let bx=20+gs.scoreAnim.player*(bw+2)+bw/2;
    fill(186,133,42,225*(1-frac));textSize(20);textAlign(CENTER,CENTER);textFont(FD);
    text('+'+gs.scoreAnim.pts,bx,ay);textFont(FB);
    gs.scoreAnim.frame++;if(gs.scoreAnim.frame>55)gs.scoreAnim=null;
  }

  // Scoreboard
  let sbY=264;
  fill(8,6,2,162);stroke(186,133,42,32);strokeWeight(0.55);
  rect(18,sbY,W-36,gs.numPlayers*44+28,4);noStroke();
  lbl('MISSION SCOREBOARD',28,sbY+14,[186,133,42,138],8,LEFT,FD);
  gs.players.slice(0,gs.numPlayers).forEach((p,i)=>{
    let ry=sbY+26+i*44,act=i===gs.currentTurn;
    let tk2=TOKENS[p.tokenIdx%TOKENS.length],rl2=ROLES[p.roleIdx%ROLES.length];
    fill(...tk2.col,act?26:11);stroke(...tk2.col,act?68:24);strokeWeight(act?0.9:0.4);
    rect(26,ry,W-52,38,3);noStroke();
    fill(...tk2.col,198);noStroke();rect(26,ry,5,38,3,0,0,3);
    lbl(rl2.icon+' '+p.name,40,ry+12,act?[186,133,42,215]:[186,133,42,122],10,LEFT,FD);
    lbl('Square '+gs.positions[i],40,ry+28,[...tk2.col,145],8);
    lbl(gs.scores[i]+' pts',W-30,ry+19,act?[186,133,42,208]:[186,133,42,102],12,RIGHT,FD);
    if(act){
      fill(...l.col,148);noStroke();rect(W-105,ry+10,66,18,9);
      fill(255,255,255,212);textSize(7.5);textAlign(CENTER,CENTER);textFont(FD);
      text('◀ current',W-72,ry+19);textFont(FB);
    }
  });

  btn('NEXT TURN  ▶',W/2-112,H-52,224,44,[26,16,3],[228,208,158,248],14.5,[186,133,42,120]);
  drawTurnBar();
}

// ── SCREEN: WINNER ────────────────────────────────────────────────────

function drawWinner(){
  let wp=gs.players[gs.winner];
  let wt=TOKENS[wp.tokenIdx%TOKENS.length];
  let wr=ROLES[wp.roleIdx%ROLES.length];
  hdr('🏆  MISSION COMPLETE — Nebula of Knowledge Reached!',[186,133,42]);

  // Confetti
  noStroke();
  for(let i=0;i<72;i++){
    let cx=(sin(i*137.5+gs.anim*0.016)*W/2)+W/2;
    let cy=(gs.anim*0.4+i*9.8)%H;
    let cols=[[200,68,68],[68,200,108],[68,108,200],[200,185,55],[158,68,200],[55,185,185]];
    fill(...cols[i%6],162);rect(cx,cy,7,11,1);
  }

  textSize(68);textAlign(CENTER,CENTER);text('🏆',W/2,H/2-150);

  let pg=0.6+0.4*sin(gs.anim*0.05);
  glow([186,133,42],24*pg);
  fill(186,133,42,238);textSize(22);textStyle(BOLD);textFont(FD);
  text(wt.label+' token  ·  '+wp.name+'  wins!',W/2,H/2-98);
  textStyle(NORMAL);clearGlow();
  fill(48,148,148,152);textSize(10);textFont(FB);
  text(wr.icon+'  '+wr.label+'  ·  First to reach the Nebula of Knowledge',W/2,H/2-74);

  divider(H/2-56,[186,133,42,80]);

  // Final scores
  let baseY=H/2-44;
  fill(10,7,2,172);stroke(186,133,42,52);strokeWeight(0.65);
  rect(W/2-202,baseY,404,gs.numPlayers*46+32,4);noStroke();
  lbl('FINAL SCORES',W/2,baseY+14,[186,133,42,142],9,CENTER,FD);

  gs.players.slice(0,gs.numPlayers).forEach((p,i)=>{
    let ry=baseY+28+i*46,win=i===gs.winner;
    let tk2=TOKENS[p.tokenIdx%TOKENS.length];
    fill(...tk2.col,win?34:12);stroke(...tk2.col,win?88:28);strokeWeight(win?1.1:0.4);
    rect(W/2-192,ry,384,38,3);noStroke();
    fill(...tk2.col,200);noStroke();rect(W/2-192,ry,5,38,3,0,0,3);
    lbl((win?'🏆  ':'')+p.name,W/2-182,ry+12,win?[186,133,42,220]:[186,133,42,128],11,LEFT,FD);
    lbl(gs.scores[i]+' pts',W/2+188,ry+19,win?[186,133,42,218]:[186,133,42,105],13,RIGHT,FD);
  });

  btn('▶  NEW MISSION',W/2-120,H-66,240,48,[28,17,3],[228,208,158,248],15,[186,133,42,130]);
  btn('⚙  CHANGE CREW',W/2-120,H-118,240,40,[16,10,4],[108,188,188,220],11,[108,188,188,95]);
}

// ── NAME INPUTS ───────────────────────────────────────────────────────

function createNameInputs(){
  for(let i=0;i<6;i++){
    let inp=createInput(gs.players[i]?.name||'Crew Member '+(i+1));
    inp.addClass('mct-input');inp.size(188,20);
    inp.input(function(){if(gs.players[i])gs.players[i].name=this.value();});
    nameInputs.push(inp);
  }
  updateInputVis();
}

function getCanvasOff(){
  let el=document.querySelector('canvas');
  if(!el)return{x:0,y:0};
  let r=el.getBoundingClientRect();
  return{x:r.left+window.scrollX,y:r.top+window.scrollY};
}

function updateInputVis(){
  let off=getCanvasOff();
  for(let i=0;i<6;i++){
    if(!nameInputs[i])continue;
    if(gs.screen==='setup'&&i<gs.numPlayers){
      let ry=R0+i*RH;
      nameInputs[i].position(off.x+328,off.y+ry+16);
      nameInputs[i].size(176,24);
      nameInputs[i].show();
      if(i<gs.players.length)nameInputs[i].value(gs.players[i].name);
    }else{nameInputs[i].hide();}
  }
}

// ── MAIN LOOP ─────────────────────────────────────────────────────────

function setup(){
  createCanvas(W,H);textFont(FB);
  buildHexGrid();createNameInputs();
  gs.hasSave=checkForSave();gs.screen='splash';
}

function draw(){
  background(10,7,2);drawHexGrid();gs.anim++;

  if(gs.screen==='challenge'&&gs.challengePhase==='active'&&gs.timerActive&&gs.timer>0){
    gs.timer--;
    if(gs.timer<=0){gs.timerActive=false;gs.screen='score';}
  }
  if(gs.rolling){
    gs.rollFrame++;if(gs.rollFrame>22){gs.rolling=false;gs.rollFrame=0;doRoll();}
  }

  if     (gs.screen==='splash')    drawSplash();
  else if(gs.screen==='setup')     drawSetup();
  else if(gs.screen==='roll')      drawRoll();
  else if(gs.screen==='challenge') drawChallenge();
  else if(gs.screen==='score')     drawScore();
  else if(gs.screen==='winner')    drawWinner();

  cursor(getHoverCursor());
}

// ── MOUSE HANDLERS ────────────────────────────────────────────────────

function mousePressed(){
  if     (gs.screen==='splash')    handleSplash();
  else if(gs.screen==='setup')     handleSetup();
  else if(gs.screen==='roll')      handleRoll();
  else if(gs.screen==='challenge') handleChallenge();
  else if(gs.screen==='score')     handleScore();
  else if(gs.screen==='winner')    handleWinner();
}

function handleSplash(){
  if(gs.hasSave){
    if(isOver(W/2-128,H/2+8,256,50)){if(loadSavedGame())updateInputVis();return;}
    if(isOver(W/2-84,H/2+72,168,36)){clearSave();gs.screen='setup';updateInputVis();return;}
    if(isOver(W/2-44,H/2+120,88,24)){clearSave();return;}
  }else{
    if(isOver(W/2-128,H/2+8,256,50)){gs.screen='setup';updateInputVis();}
  }
}

function handleSetup(){
  [2,3,4,5,6].forEach((n,i)=>{
    if(isOver(128+i*62,98,48,32)){
      gs.numPlayers=n;
      while(gs.players.length<n)
        gs.players.push({name:'Crew Member '+(gs.players.length+1),tokenIdx:gs.players.length%6,roleIdx:gs.players.length%5,defaultLevel:1});
      while(gs.players.length>n)gs.players.pop();
      gs.scores=Array(n).fill(0);gs.positions=Array(n).fill(0);updateInputVis();
    }
  });
  for(let i=0;i<gs.numPlayers;i++){
    let ry=R0+i*RH,p=gs.players[i];
    TOKENS.forEach((_,ti)=>{
      if(dist(mouseX,mouseY,186+ti*24,ry+32)<20){
        let inUse=gs.players.slice(0,gs.numPlayers).some((pp,pi)=>pi!==i&&pp.tokenIdx===ti);
        if(!inUse)p.tokenIdx=ti;
      }
    });
    ROLES.forEach((_,ri)=>{if(dist(mouseX,mouseY,186+ri*28,ry+62)<18)p.roleIdx=ri;});
    LEVELS.forEach((_,j)=>{if(isOver(528+j*76,ry+12,70,34))p.defaultLevel=j;});
  }
  let by=R0+gs.numPlayers*RH+16;
  if(isOver(W/2-128,by,256,50)){
    nameInputs.forEach((inp,i)=>{if(i<gs.numPlayers&&inp)gs.players[i].name=inp.value()||('Crew Member '+(i+1));});
    resetGame();
  }
}

function handleRoll(){
  if(!gs.rolling&&!gs.diceRoll&&isOver(DX-76,DY+68,152,52)){gs.rolling=true;gs.rollFrame=0;}
  if(!gs.rolling&&gs.diceRoll&&isOver(DX-128,DY+110,256,42)){
    gs.screen='challenge';gs.selectedLvl=null;gs.challengePhase='picking';
  }
}

function handleChallenge(){
  if(gs.challengePhase==='picking'){
    LEVELS.forEach((l,i)=>{
      let col2=i%2,row=floor(i/2);
      let lx=18+col2*(floor((W-42)/2)+4),lw=floor((W-42)/2);
      let ly=148+row*256,lh=250;
      if(isOver(lx,ly,lw,lh)){
        gs.selectedLvl=l.id;gs.currentQ=pickQ(curSq().t,l.id);
        gs.challengePhase='active';gs.timer=TIMER_F[l.id];gs.timerMax=TIMER_F[l.id];gs.timerActive=true;
        addLog('📋 Challenge: '+l.label+' — '+curSq().code);
      }
    });
  }else{
    if(isOver(W/2-140,412,280,48)){gs.timerActive=false;gs.screen='score';}
    if(isOver(W/2-88,468,176,32)){gs.timerActive=false;awardPoints(gs.currentTurn,0);}
  }
}

function handleScore(){
  let l=lv(gs.selectedLvl??1),bw=(W-44)/(gs.numPlayers+1)-2;
  gs.players.slice(0,gs.numPlayers).forEach((_,i)=>{
    if(isOver(20+i*(bw+2),226,bw,66))awardPoints(i,l.pts);
  });
  if(isOver(20+gs.numPlayers*(bw+2),226,bw,66))awardPoints(gs.currentTurn,0);
  if(isOver(W/2-112,H-52,224,44))nextTurn();
}

function handleWinner(){
  if(isOver(W/2-120,H-66,240,48))resetGame();
  if(isOver(W/2-120,H-118,240,40)){gs.screen='setup';updateInputVis();}
}

// ── KEYBOARD ─────────────────────────────────────────────────────────

function keyPressed(){
  if(gs.screen==='roll'){
    if(key===' '||keyCode===ENTER){
      if(!gs.rolling&&!gs.diceRoll){gs.rolling=true;gs.rollFrame=0;return false;}
      else if(!gs.rolling&&gs.diceRoll){gs.screen='challenge';gs.selectedLvl=null;gs.challengePhase='picking';return false;}
    }
  }
  if(gs.screen==='challenge'&&gs.challengePhase==='picking'){
    if(['1','2','3','4'].includes(key)){
      let li=int(key)-1;
      gs.selectedLvl=li;gs.currentQ=pickQ(curSq().t,li);
      gs.challengePhase='active';gs.timer=TIMER_F[li];gs.timerMax=TIMER_F[li];gs.timerActive=true;
      return false;
    }
  }
  if(gs.screen==='score'){
    if(keyCode===ENTER){nextTurn();return false;}
    let l=lv(gs.selectedLvl??1);
    for(let i=0;i<gs.numPlayers;i++)if(key===''+(i+1)){awardPoints(i,l.pts);return false;}
    if(key==='0'){awardPoints(gs.currentTurn,0);return false;}
  }
  if(gs.screen==='winner'){
    if(key==='r'||key==='R'){resetGame();return false;}
    if(keyCode===ESCAPE){gs.screen='setup';updateInputVis();return false;}
  }
  if(key===' ')return false;
}

// ── HOVER CURSOR ──────────────────────────────────────────────────────

function getHoverCursor(){
  let c=ARROW;
  if(gs.screen==='splash'){
    if(gs.hasSave){
      if(isOver(W/2-128,H/2+8,256,50)||isOver(W/2-84,H/2+72,168,36)||isOver(W/2-44,H/2+120,88,24))c=HAND;
    }else{if(isOver(W/2-128,H/2+8,256,50))c=HAND;}
  }
  if(gs.screen==='setup'){
    [2,3,4,5,6].forEach((_,i)=>{if(isOver(128+i*62,98,48,32))c=HAND;});
    if(isOver(W/2-128,R0+gs.numPlayers*RH+16,256,50))c=HAND;
    for(let i=0;i<gs.numPlayers;i++){
      let ry=R0+i*RH;
      TOKENS.forEach((_,ti)=>{if(dist(mouseX,mouseY,186+ti*24,ry+32)<20)c=HAND;});
      ROLES.forEach((_,ri)=>{if(dist(mouseX,mouseY,186+ri*28,ry+62)<18)c=HAND;});
      LEVELS.forEach((_,j)=>{if(isOver(528+j*76,ry+12,70,34))c=HAND;});
    }
  }
  if(gs.screen==='roll'){
    if(!gs.rolling&&!gs.diceRoll&&isOver(DX-76,DY+68,152,52))c=HAND;
    if(!gs.rolling&&gs.diceRoll&&isOver(DX-128,DY+110,256,42))c=HAND;
  }
  if(gs.screen==='challenge'){
    if(gs.challengePhase==='picking'){
      LEVELS.forEach((_,i)=>{
        let col2=i%2,row=floor(i/2);
        let lx=18+col2*(floor((W-42)/2)+4),lw=floor((W-42)/2);
        if(isOver(lx,148+row*256,lw,250))c=HAND;
      });
    }else{
      if(isOver(W/2-140,412,280,48)||isOver(W/2-88,468,176,32))c=HAND;
    }
  }
  if(gs.screen==='score'){
    let bw=(W-44)/(gs.numPlayers+1)-2;
    for(let i=0;i<=gs.numPlayers;i++)if(isOver(20+i*(bw+2),226,bw,66))c=HAND;
    if(isOver(W/2-112,H-52,224,44))c=HAND;
  }
  if(gs.screen==='winner'){
    if(isOver(W/2-120,H-66,240,48)||isOver(W/2-120,H-118,240,40))c=HAND;
  }
  return c;
}
