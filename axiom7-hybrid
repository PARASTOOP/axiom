// ── PERSISTENCE ───────────────────────────────────────────────────────

function saveGame(){
  try{localStorage.setItem('axiom7v2',JSON.stringify({
    numPlayers:gs.numPlayers,players:gs.players,positions:gs.positions,
    scores:gs.scores,currentTurn:gs.currentTurn,winner:gs.winner,
    missionLog:gs.missionLog,locationsVisited:gs.locationsVisited||[],
  }));}catch(e){}
}
function loadSavedGame(){
  try{
    let d=JSON.parse(localStorage.getItem('axiom7v2'));
    if(!d||!d.players)return false;
    Object.assign(gs,{numPlayers:d.numPlayers,players:d.players,
      positions:d.positions,scores:d.scores,currentTurn:d.currentTurn,
      winner:d.winner,missionLog:d.missionLog||[],locationsVisited:d.locationsVisited||[]});
    gs.screen=typeof d.winner==='number'?'winner':'roll'; return true;
  }catch(e){return false;}
}
function checkForSave(){
  try{let d=JSON.parse(localStorage.getItem('axiom7v2'));return!!(d&&d.players&&d.positions);}
  catch(e){return false;}
}
function clearSave(){try{localStorage.removeItem('axiom7v2');}catch(e){}gs.hasSave=false;}

// ── HEX GRID BACKGROUND ───────────────────────────────────────────────

function buildHexGrid(){
  hexGrid=[];
  let r=22,dx=r*1.73,dy=r*1.5;
  for(let row=-1;row<H/dy+2;row++)
    for(let col=-1;col<W/dx+2;col++){
      let ox=(row%2)*dx/2;
      hexGrid.push({x:col*dx+ox,y:row*dy});
    }
}

function drawHexGrid(){
  let t=gs.anim*0.008; noFill();
  hexGrid.forEach(h=>{
    let dist=sqrt((h.x-W/2)**2+(h.y-H/2)**2);
    let wave=0.28+0.14*sin(t-dist*0.012);
    stroke(186,133,42,10*wave); strokeWeight(0.45);
    let r=22; beginShape();
    for(let i=0;i<6;i++){let a2=i*PI/3;vertex(h.x+r*cos(a2),h.y+r*sin(a2));}
    endShape(CLOSE);
  });
  noStroke();
}

